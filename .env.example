# ============================================================
# SupportPlus AI - Environment Configuration
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.
# ============================================================

# ── Google Gemini (Primary LLM) ─────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.3

# ── Groq (Fallback LLM) ──────────────────────────────────────
# Get your free key at: https://console.groq.com/keys
# Automatically used when Gemini fails (rate limit / error)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=512
GROQ_TEMPERATURE=0.3

# ── Firecrawl (Web Search) ───────────────────────────────────
# Get your key at: https://www.firecrawl.dev/
# Leave blank to use mock web results
FIRECRAWL_API_KEY=your_firecrawl_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT=10

# ── RAG Settings ─────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ── Memory Backend ───────────────────────────────────────────
# Options: sqlite | redis
MEMORY_BACKEND=sqlite
MEMORY_MAX_HISTORY=10
# Redis URL (only used if MEMORY_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0

# ── Server ───────────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=INFO
